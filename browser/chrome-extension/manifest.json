{
  "manifest_version": 3,
  "name": "dbrain Link Saver",
  "description": "Save the current page URL to dbrain.",
  "version": "0.1.0",
  "action": {
    "default_title": "Save current page to dbrain"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
